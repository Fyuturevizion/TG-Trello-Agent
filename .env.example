# Local config template — copy to .env or .dev.vars (never commit real secrets unless you intend to)
#
# Tier 1 — Telegram → Trello triage (Worker secrets + vars). Nothing below Slack/Cursor is required for /report.
# Tier 2 — Master Splinter (/master-splinter): add CURSOR_API_KEY on the Worker only.
# Tier 3 — Slack Sensei (Phase 2, optional): ignore until you wire Sentry → Slack in this Worker.
# Deploy — npm run deploy / GitHub Actions need only CLOUDFLARE_API_TOKEN (+ account id).

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=53d52ffd40feb5356ce596aadef30109

# --- Tier 1: triage ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_QA_CHAT_ID=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_INBOX_LIST_ID=
WEBAPP_URL=
# Optional triage tuning (labels/custom fields: npm run resolve:trello-ids)
TRELLO_PRODUCT_LIST_ID=
TRELLO_DEVICE_OPTION_NATIVE_APP=
TRELLO_BOARD_ID=
TRELLO_DONE_LIST_ID=
TRELLO_DEV_BOARD_ID=
WEBHOOK_BASE_URL=
# Optional access control
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_DOJO_CHAT_ID=-1004465145918
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_ADMIN_USERNAMES=
TELEGRAM_QA_CHANNEL_MEMBERS_FULL_ACCESS=true
TELEGRAM_DOJO_KEEPER_ID=
# Worker secret (not in git): DOJO_ADMIN_SECRET=

# --- Tier 2: Splinter (optional; defaults also in wrangler.jsonc vars) ---
CURSOR_API_KEY=
CURSOR_AGENT_REPO_URL=https://github.com/Fyuturevizion/TG-Trello-Agent
CURSOR_AGENT_FAST=true
CURSOR_AGENT_MAX_SESSION_PROMPTS=8

# --- Tier 3: Slack Sensei (optional; not used by Telegram triage) ---
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_SENSEI_CHANNEL_ID=
SENTRY_WEBHOOK_SECRET=
TRELLO_SENSEI_LIST_ID=
