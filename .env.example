TRELLO_SENSEI_LIST_ID=

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_INBOX_LIST_ID=

WEBAPP_URL=
WEBHOOK_BASE_URL=

TRELLO_BOARD_ID=
TRELLO_DONE_LIST_ID=
TRELLO_DEV_BOARD_ID=

CURSOR_API_KEY=
CURSOR_AGENT_REPO_URL=https://github.com/Fyuturevizion/TG-Trello-Agent
