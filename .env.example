# Copy to .dev.vars for local dev (never commit .dev.vars)
# Bot: @WLTH_Triage_Bot

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_QA_CHAT_ID=
# Restrict bot commands to these Telegram user IDs (comma-separated)
TELEGRAM_ALLOWED_USER_IDS=
# Admin-only commands (/setup). Defaults to TELEGRAM_ALLOWED_USER_IDS if unset.
TELEGRAM_ADMIN_USER_IDS=

TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_INBOX_LIST_ID=

# Custom fields on Support/Triage (defaults built into Worker if unset)
TRELLO_CUSTOM_FIELD_DEVICE=69130d9c54d5911255a8d456
TRELLO_CUSTOM_FIELD_ERC=69130fb70d665e3c6726a906

# Optional label IDs (from npm run resolve-trello-ids)
TRELLO_LABEL_BUG=
TRELLO_LABEL_IDEA=
TRELLO_LABEL_IOS=
TRELLO_LABEL_ANDROID=
TRELLO_LABEL_WEB=

# For scripts/set-webhook.ts (no trailing slash)
WEBAPP_URL=https://wlth-tg-trello-triage.your-account.workers.dev
WEBHOOK_BASE_URL=https://wlth-tg-trello-triage.your-account.workers.dev

TRELLO_BOARD_ID=
TRELLO_DONE_LIST_ID=
# Optional: Development board id (cross-board moves) and archive list ids (comma-separated)
TRELLO_DEV_BOARD_ID=
TRELLO_ARCHIVE_LIST_IDS=

# Full webhook URL for cron watchdog (output of set-webhook)
WEBHOOK_URL=

# Optional filter for resolve-trello-ids.ts
TRELLO_BOARD_NAME=Triage

SESSION_TTL_SECONDS=3600
MAX_PHOTOS=3

# Admin-only /agent — Cursor Cloud Agents API (Dashboard → Integrations)
CURSOR_API_KEY=
CURSOR_AGENT_REPO_URL=https://github.com/your-org/TG-Trello-Agent
CURSOR_AGENT_REPO_REF=main
CURSOR_AGENT_MODEL=composer-2.5
CURSOR_AGENT_AUTO_PR=true
