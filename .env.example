# Local config template — copy to .env or .dev.vars (never commit real secrets unless you intend to)

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=53d52ffd40feb5356ce596aadef30109

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated for multiple QA channels
TELEGRAM_QA_CHAT_ID=
# Numeric Telegram user ID for dojo admin only (/setup, /master-splinter)
TELEGRAM_ADMIN_USER_IDS=
TELEGRAM_CODE_ADMIN_USER_IDS=
TELEGRAM_SPLINTER_USER_IDS=
TELEGRAM_SPLINTER_USERNAMES=
TELEGRAM_ADMIN_USERNAMES=timmetavest
# Only you — must match your Telegram numeric user ID
TELEGRAM_DOJO_KEEPER_ID=
# Worker secret (not in git): DOJO_ADMIN_SECRET=ratking-pizza-decree

# Slack Sensei (Phase 2)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_SENSEI_CHANNEL_ID=
SENTRY_WEBHOOK_SECRET=
# Optional; falls back to TRELLO_INBOX_LIST_ID
TRELLO_SENSEI_LIST_ID=

TRELLO_API_KEY=
TRELLO_TOKEN=
# Optional: Native App device option id (auto-created via Trello API if unset)
TRELLO_DEVICE_OPTION_NATIVE_APP=

WEBAPP_URL=
WEBHOOK_BASE_URL=

TRELLO_BOARD_ID=
TRELLO_DONE_LIST_ID=
TRELLO_DEV_BOARD_ID=
# Product QA queues (phase-specific lists preferred)
TRELLO_PRODUCT_PHASE1_LIST_ID=
TRELLO_PRODUCT_PHASE2_LIST_ID=
TRELLO_PRODUCT_PHASE3_LIST_ID=
# Fallback when phase lists are unset
TRELLO_PRODUCT_LIST_ID=
TRELLO_LABEL_PRODUCT=

CURSOR_API_KEY=
CURSOR_AGENT_REPO_URL=https://github.com/Fyuturevizion/TG-Trello-Agent
CURSOR_AGENT_FAST=true
CURSOR_AGENT_MAX_SESSION_PROMPTS=8
