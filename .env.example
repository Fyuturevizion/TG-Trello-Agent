TELEGRAM_QA_CHAT_ID=
TELEGRAM_ADMIN_USER_IDS=
# Only you — must match your Telegram numeric user ID
TELEGRAM_DOJO_KEEPER_ID=
# Worker secret (not in git): DOJO_ADMIN_SECRET=ratking-pizza-decree

# Slack Sensei (Phase 2)
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_SENSEI_CHANNEL_ID=
SENTRY_WEBHOOK_SECRET=
